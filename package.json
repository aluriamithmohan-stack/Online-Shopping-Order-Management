{
  "name": "online-shopping-order-management",
  "version": "1.0.0",
  "description": "Online Shopping and Order Management System - College DevOps Practical",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/functional.test.js",
    "test:selenium": "mvn -f selenium-tests/pom.xml test -DbaseUrl=http://localhost:3000",
    "test:mandatory": "mvn -f selenium-tests/pom.xml test -Dtest=MandatoryTests -DbaseUrl=http://localhost:3000",
    "test:additional": "mvn -f selenium-tests/pom.xml test -Dtest=AdditionalTests -DbaseUrl=http://localhost:3000"
  },
  "keywords": [
    "ecommerce",
    "nodejs",
    "express",
    "sqlite"
  ],
  "author": "DevOps Practical",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
