<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="container">
    <h1>✅ Checkout</h1>
    <div class="breadcrumb">
      <a href="/">Home</a><span class="sep">/</span>
      <a href="/cart">Cart</a><span class="sep">/</span>
      <span>Checkout</span>
    </div>
  </div>
</div>

<div class="container" style="padding-bottom:3rem;">
  <%- include('partials/flash') %>

  <form id="checkoutForm" action="/orders/checkout/place" method="POST">
  <div style="display:grid; grid-template-columns:1fr 380px; gap:2rem; align-items:start;">

    <!-- Order Details -->
    <div>
      <!-- Shipping Address -->
      <div class="card mb-6">
        <div class="card-header"><h3 style="margin:0;">📍 Shipping Address</h3></div>
        <div class="card-body">
            <div class="form-group">
              <label class="form-label" for="shipping_address">Delivery Address <span class="required">*</span></label>
              <textarea
                class="form-control"
                id="shipping_address"
                name="shipping_address"
                rows="3"
                placeholder="Enter your full delivery address..."
                data-testid="shippingAddress"
                required
              >123 Main Street, City, State - 400001</textarea>
            </div>
        </div>
      </div>

      <!-- Order Items -->
      <div class="card">
        <div class="card-header"><h3 style="margin:0;">🛍️ Order Items (<%= cartItems.length %>)</h3></div>
        <div style="overflow-x:auto;">
          <table class="cart-table">
            <thead>
              <tr>
                <th colspan="2">Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% cartItems.forEach(item => { %>
              <tr>
                <td style="width:64px;">
                  <img src="<%= item.image_url %>" alt="<%= item.name %>" class="cart-item-img"
                       onerror="this.src='/images/default-product.png'" />
                </td>
                <td style="font-weight:600;"><%= item.name %></td>
                <td><%= item.quantity %></td>
                <td>₹<%= item.price.toLocaleString('en-IN', {minimumFractionDigits:2}) %></td>
                <td style="font-weight:700; color:var(--primary);">₹<%= item.subtotal.toLocaleString('en-IN', {minimumFractionDigits:2}) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Order Summary -->
    <div>
      <div class="cart-summary" style="position:sticky; top:80px;">
        <h3>Payment Summary</h3>
        <div class="summary-row">
          <span>Items (<%= cartItems.reduce((s, i) => s + i.quantity, 0) %>)</span>
          <span>₹<%= total.toLocaleString('en-IN', {minimumFractionDigits:2}) %></span>
        </div>
        <div class="summary-row">
          <span>Delivery</span>
          <span style="color:var(--success); font-weight:600;">FREE</span>
        </div>
        <div class="summary-row">
          <span>Tax (GST 18%)</span>
          <span>Included</span>
        </div>
        <div class="summary-row total">
          <span>Total Amount</span>
          <span>₹<%= total.toLocaleString('en-IN', {minimumFractionDigits:2}) %></span>
        </div>

        <div style="background:var(--warning-light); border:1px solid #fde68a; border-radius:var(--radius); padding:0.75rem; margin:1rem 0; font-size:0.8rem; color:#92400e;">
          🔒 <strong>Simulated Payment</strong> — No real charges will be made.
        </div>

        <button
          type="submit"
          class="btn btn-success btn-full btn-lg"
          id="placeOrderBtn"
          data-testid="placeOrderBtn"
          data-confirm="Place order for ₹<%= total.toLocaleString('en-IN', {minimumFractionDigits:2}) %>?"
        >
          ✅ Place Order
        </button>
        <a href="/cart" class="btn btn-secondary btn-full" style="margin-top:0.75rem;">← Back to Cart</a>
      </div>
    </div>
  </div>
  </form>
</div>

<%- include('partials/footer') %>
