<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="auth-wrapper" style="background:linear-gradient(135deg,#1e1b4b 0%,#312e81 100%);">
  <div class="auth-card">
    <div class="auth-card-header" style="background:linear-gradient(135deg,#1e1b4b 0%,#4c1d95 100%);">
      <div class="auth-logo">🔐</div>
      <h2>Admin Login</h2>
      <p>ShopEase Administration Panel</p>
    </div>
    <div class="auth-card-body">
      <%- include('partials/flash') %>

      <form action="/admin/login" method="POST" id="adminLoginForm">
        <div class="form-group">
          <label class="form-label" for="email">Admin Email <span class="required">*</span></label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="Enter admin email"
            required
            id="adminEmail"
            data-testid="adminEmail"
            autocomplete="username"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password <span class="required">*</span></label>
          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            placeholder="Enter admin password"
            required
            data-testid="adminPassword"
            autocomplete="current-password"
          />
        </div>

        <button
          type="submit"
          class="btn btn-full btn-lg"
          id="adminLoginBtn"
          data-testid="adminLoginBtn"
          style="background:linear-gradient(135deg,#4c1d95,#1e1b4b); color:white; border:none; margin-top:0.5rem;"
        >
          🔐 Admin Sign In
        </button>
      </form>

      <div class="auth-footer mt-4">
        <a href="/auth/login">← Customer Login</a>
      </div>

      <!-- Demo admin credentials -->
      <div style="margin-top:1rem; padding:0.875rem; background:var(--gray-50); border-radius:var(--radius); font-size:0.8rem; color:var(--gray-500); border:1px solid var(--gray-200);">
        <strong style="color:var(--gray-700);">Admin Credentials:</strong><br/>
        Email: <code>admin@shopease.com</code><br/>
        Password: <code>Admin@123</code>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
