<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="container">
    <h1>📦 My Orders</h1>
    <div class="breadcrumb">
      <a href="/">Home</a><span class="sep">/</span>
      <span>Order History</span>
    </div>
  </div>
</div>

<div class="container" style="padding-bottom:3rem;">
  <%- include('partials/flash') %>

  <% if (orders.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📦</div>
    <h3>No orders yet</h3>
    <p>You haven't placed any orders. Start shopping to see your order history here.</p>
    <a href="/products" class="btn btn-primary">Start Shopping</a>
  </div>
  <% } else { %>
  <div class="card">
    <div class="card-header">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin:0;">Order History (<%= orders.length %>)</h3>
        <a href="/products" class="btn btn-sm btn-secondary">🛍️ Shop More</a>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table" id="ordersTable" data-testid="ordersTable">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Date</th>
            <th>Items</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
          <tr>
            <td>
              <span style="font-family:monospace; font-weight:700; color:var(--primary);">
                <%= order.order_code %>
              </span>
            </td>
            <td style="white-space:nowrap; color:var(--gray-600);">
              <%= new Date(order.created_at).toLocaleDateString('en-IN', {
                day: '2-digit', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
              }) %>
            </td>
            <td><%= order.item_count %> item<%= order.item_count !== 1 ? 's' : '' %></td>
            <td style="font-weight:700; color:var(--dark);">
              ₹<%= order.total_amount.toLocaleString('en-IN', {minimumFractionDigits:2}) %>
            </td>
            <td>
              <span class="badge <%= order.status === 'Confirmed' ? 'badge-success' : order.status === 'Cancelled' ? 'badge-danger' : 'badge-primary' %>">
                <%= order.status %>
              </span>
            </td>
            <td>
              <a href="/orders/<%= order.id %>" class="btn btn-sm btn-secondary" data-testid="viewOrderBtn">
                View Details
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
