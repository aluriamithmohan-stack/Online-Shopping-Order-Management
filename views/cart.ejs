<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="container">
    <h1>🛒 Shopping Cart</h1>
    <div class="breadcrumb">
      <a href="/">Home</a><span class="sep">/</span>
      <a href="/products">Products</a><span class="sep">/</span>
      <span>Cart</span>
    </div>
  </div>
</div>

<div class="container" style="padding-bottom:3rem;">
  <%- include('partials/flash') %>

  <% if (items.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">🛒</div>
    <h3>Your cart is empty</h3>
    <p>Add some products to get started.</p>
    <a href="/products" class="btn btn-primary">Browse Products</a>
  </div>

  <% } else { %>
  <div class="cart-layout">
    <!-- Cart Items -->
    <div>
      <div class="card">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
          <h3 style="margin:0;">Cart Items (<%= items.length %>)</h3>
          <form action="/cart/clear" method="POST">
            <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Clear all items from cart?">🗑️ Clear Cart</button>
          </form>
        </div>
        <div style="overflow-x:auto;">
          <table class="cart-table">
            <thead>
              <tr>
                <th colspan="2">Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
              <tr class="cart-row" data-price="<%= item.price %>">
                <td style="width:80px;">
                  <img src="<%= item.image_url %>" alt="<%= item.name %>" class="cart-item-img"
                       onerror="this.src='/images/default-product.png'" />
                </td>
                <td>
                  <div style="font-weight:600; color:var(--dark);"><%= item.name %></div>
                  <div style="font-size:0.8rem; color:var(--gray-500);">
                    <% if (!item.is_active) { %>
                      <span style="color:var(--danger);">⚠️ Product unavailable</span>
                    <% } else if (item.stock < item.quantity) { %>
                      <span style="color:var(--warning);">⚠️ Only <%= item.stock %> in stock</span>
                    <% } else { %>
                      Available
                    <% } %>
                  </div>
                </td>
                <td style="font-weight:600;">₹<%= item.price.toLocaleString('en-IN', {minimumFractionDigits:2}) %></td>
                <td>
                  <form action="/cart/update" method="POST" id="updateForm_<%= item.cart_item_id %>">
                    <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>" />
                    <div class="qty-control">
                      <button type="button" class="qty-btn qty-minus">−</button>
                      <input
                        type="number"
                        class="cart-qty-input"
                        id="quantity"
                        name="quantity"
                        value="<%= item.quantity %>"
                        min="1"
                        max="<%= item.stock %>"
                        data-testid="quantity"
                      />
                      <button type="button" class="qty-plus qty-btn">+</button>
                    </div>
                    <button
                      type="submit"
                      class="btn btn-sm btn-secondary"
                      id="updateCartBtn"
                      data-testid="updateCartBtn"
                      style="margin-top:0.4rem; width:100%;"
                    >
                      Update
                    </button>
                  </form>
                </td>
                <td class="cart-subtotal fw-bold" style="color:var(--primary);">
                  ₹<%= item.subtotal.toLocaleString('en-IN', {minimumFractionDigits:2}) %>
                </td>
                <td>
                  <form action="/cart/remove" method="POST">
                    <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>" />
                    <button
                      type="submit"
                      class="btn btn-sm btn-outline-danger"
                      id="removeProductBtn"
                      data-testid="removeProductBtn"
                      data-confirm="Remove this item from cart?"
                    >
                      🗑️ Remove
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Cart Summary -->
    <div>
      <div class="cart-summary">
        <h3>Order Summary</h3>
        <% let subtotalCheck = items.reduce((s, i) => s + i.subtotal, 0); %>
        <div class="summary-row">
          <span>Items (<%= items.reduce((s, i) => s + i.quantity, 0) %>)</span>
          <span>₹<%= subtotalCheck.toLocaleString('en-IN', {minimumFractionDigits:2}) %></span>
        </div>
        <div class="summary-row">
          <span>Shipping</span>
          <span style="color:var(--success); font-weight:600;">FREE</span>
        </div>
        <div class="summary-row total">
          <span>Total</span>
          <span>₹<%= total.toLocaleString('en-IN', {minimumFractionDigits:2}) %></span>
        </div>

        <a
          href="/orders/checkout/review"
          class="btn btn-primary btn-full btn-lg"
          id="checkoutBtn"
          data-testid="checkoutBtn"
          style="margin-top:1.25rem;"
        >
          Proceed to Checkout →
        </a>
        <a href="/products" class="btn btn-secondary btn-full" style="margin-top:0.75rem;">
          ← Continue Shopping
        </a>
      </div>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
