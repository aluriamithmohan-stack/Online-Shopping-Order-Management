<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="auth-logo">🛒</div>
      <h2>Welcome Back!</h2>
      <p>Sign in to your ShopEase account</p>
    </div>
    <div class="auth-card-body">
      <%- include('partials/flash') %>

      <form action="/auth/login" method="POST" id="loginForm">
        <div class="form-group">
          <label class="form-label" for="email">Email Address <span class="required">*</span></label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="Enter your email"
            required
            data-testid="email"
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password <span class="required">*</span></label>
          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
            data-testid="password"
            autocomplete="current-password"
          />
        </div>

        <button
          type="submit"
          class="btn btn-primary btn-full"
          id="loginBtn"
          data-testid="loginBtn"
          style="margin-top:0.5rem;"
        >
          Sign In
        </button>
      </form>

      <div class="auth-footer mt-4">
        <div>Don't have an account? <a href="/auth/register">Create one</a></div>
        <div style="margin-top:0.5rem;">
          <a href="/admin/login" style="color:var(--gray-400); font-size:0.8rem;">Admin Login →</a>
        </div>
      </div>

      <!-- Demo credentials hint -->
      <div style="margin-top:1rem; padding:0.875rem; background:var(--gray-50); border-radius:var(--radius); font-size:0.8rem; color:var(--gray-500); border:1px solid var(--gray-200);">
        <strong style="color:var(--gray-700);">Demo Credentials:</strong><br/>
        Email: <code>demo@shopease.com</code><br/>
        Password: <code>Demo@123</code>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
